# NOVALYN frontend configuration. Copy to `.env.local` to override.

# Where the dev server proxies /api requests. Development only.
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Base URL of the API as the browser sees it. Leave unset to use the same
# origin as the frontend (the dev proxy, or a reverse proxy in production).
# VITE_API_URL=/api/v1
